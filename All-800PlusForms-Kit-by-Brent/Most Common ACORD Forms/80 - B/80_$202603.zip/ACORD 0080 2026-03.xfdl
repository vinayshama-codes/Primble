        </ae>
        <ae>
          <ae>alignt2t</ae>
          <ae>CA_</ae>
        </ae>
        <ae>
          <ae>offset</ae>
          <ae>-10</ae>
          <ae>0</ae>
        </ae>
      </itemlocation>
    </label>
    <label sid="CC_">
      <value>of a loss or benefit or knowingly (or willfully)* presents false information in an application for insurance is guilty of a crime and may be</value>
      <fontinfo>
        <ae>Arial</ae>
        <ae>9</ae>
        <ae>plain</ae>
      </fontinfo>
      <justify>left</justify>
      <itemlocation>
        <ae>
          <ae>absolute</ae>
          <ae>10</ae>
          <ae>68</ae>
        </ae>
        <ae>
          <ae>extent</ae>
          <ae>940</ae>
          <ae>24</ae>
        </ae>
      </itemlocation>
    </label>
    <label sid="CD_">
      <value>subject to fines and confinement in prison. *Applies in MD Only.</value>
      <fontinfo>
        <ae>Arial</ae>
        <ae>9</ae>
        <ae>plain</ae>
      </fontinfo>
      <justify>left</justify>
