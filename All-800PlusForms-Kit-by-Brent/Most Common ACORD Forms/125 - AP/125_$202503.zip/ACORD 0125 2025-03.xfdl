          <ae>863</ae>
        </ae>
        <ae>
          <ae>extent</ae>
          <ae>940</ae>
          <ae>24</ae>
        </ae>
      </itemlocation>
    </label>
    <label sid="ET_">
      <value>subject to fines and confinement in prison. *Applies in MD Only.</value>
      <fontinfo>
        <ae>Arial</ae>
        <ae>9</ae>
        <ae>plain</ae>
