      <pecs:short_cut xfdl:compute="toggle(global.global.keypress, '', 'F9') == '1' ? (set('activated','on')) : ''"></pecs:short_cut>
      <bgcolor>
        <ae>190</ae>
        <ae>0</ae>
        <ae>76</ae>
      </bgcolor>
      <justify>center</justify>
      <fontcolor>
        <ae compute="mouseover == 'on' ? 'yellow' : 'white'">white</ae>
      </fontcolor>
      <fontinfo>
        <ae>Helvetica</ae>
        <ae>7</ae>
        <ae>bold</ae>
      </fontinfo>
      <value>Quick Guide</value>
      <borderwidth>0</borderwidth>
      <transmitformat>application/x-www-form-urlencoded</transmitformat>
      <url>
        <ae>http://www.acord.org/webfiles/forms/xfdl/quickguide.htm</ae>
      </url>
      <visible>on</visible>
      <itemlocation>
        <ae>
          <ae>within</ae>
          <ae>TOOLBAR</ae>
        </ae>
        <ae>
          <ae>absolute</ae>
          <ae>595</ae>
          <ae>45</ae>
        </ae>
        <ae>
          <ae>extent</ae>
          <ae>78</ae>
          <ae>21</ae>
        </ae>
      </itemlocation>
      <previous>feedback_BUTTON</previous>
      <next>prev_button</next>
    </button>
