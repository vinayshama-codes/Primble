          <ae>extent</ae>
          <ae>952</ae>
          <ae>24</ae>
        </ae>
      </itemlocation>
    </label>
    <label sid="AD_">
      <value>dollars and the stated value of the claim for each such violation.</value>
      <fontinfo>
        <ae>Arial</ae>
        <ae>9</ae>
        <ae>plain</ae>
