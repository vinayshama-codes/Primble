          <ae>23</ae>
        </ae>
      </itemlocation>
    </label>
    <label sid="Q_">
      <value>and, upon conviction, shall be sanctioned for each violation by a fine of not less than five thousand dollars ($5,000) and not more than ten thousand dollars ($10,000),</value>
