          <ae>1260</ae>
        </ae>
      </itemlocation>
    </spacer>
    <label sid="A_">
      <value>ACORD 131 (2017/11)</value>
      <fontinfo>
        <ae>Arial</ae>
        <ae>8</ae>
        <ae>bold</ae>
      </fontinfo>
      <justify>left</justify>
      <itemlocation>
        <ae>
          <ae>absolute</ae>
          <ae>4</ae>
          <ae>1229</ae>
        </ae>
        <ae>
          <ae>extent</ae>
          <ae>146</ae>
          <ae>23</ae>
        </ae>
      </itemlocation>
    </label>
    <line sid="B_">
      <itemlocation>
        <ae>
          <ae>absolute</ae>
          <ae>18</ae>
          <ae>883</ae>
        </ae>
        <ae>
          <ae>extent</ae>
          <ae>0</ae>
          <ae>0</ae>
        </ae>
      </itemlocation>
    </line>
    <label sid="C_">
      <value>Applicable in PR</value>
      <fontinfo>
        <ae>Arial</ae>
        <ae>10</ae>
        <ae>bold</ae>
      </fontinfo>
      <justify>left</justify>
      <itemlocation>
        <ae>
          <ae>after</ae>
          <ae>B_</ae>
        </ae>
        <ae>
          <ae>alignvertc2c</ae>
          <ae>B_</ae>
        </ae>
        <ae>
          <ae>offset</ae>
          <ae>-6</ae>
          <ae>0</ae>
        </ae>
      </itemlocation>
    </label>
    <label sid="D_">
      <value>:  Any person who knowingly and with the intention of defrauding presents false information in an insurance</value>
      <fontinfo>
        <ae>Arial</ae>
        <ae>10</ae>
        <ae>plain</ae>
      </fontinfo>
      <justify>left</justify>
      <itemlocation>
        <ae>
          <ae>after</ae>
          <ae>C_</ae>
        </ae>
        <ae>
          <ae>alignt2t</ae>
          <ae>C_</ae>
        </ae>
        <ae>
          <ae>offset</ae>
          <ae>-10</ae>
          <ae>0</ae>
        </ae>
      </itemlocation>
    </label>
    <label sid="E_">
      <value>application, or presents, helps, or causes the presentation of a fraudulent claim for the payment of a loss or any other benefit,</value>
      <fontinfo>
        <ae>Arial</ae>
        <ae>10</ae>
        <ae>plain</ae>
      </fontinfo>
      <justify>left</justify>
      <itemlocation>
        <ae>
          <ae>absolute</ae>
          <ae>16</ae>
          <ae>890</ae>
        </ae>
        <ae>
          <ae>extent</ae>
          <ae>930</ae>
          <ae>27</ae>
        </ae>
      </itemlocation>
    </label>
    <label sid="F_">
      <value>or presents more than one claim for the same damage or loss, shall incur a felony and, upon conviction, shall be sanctioned for</value>
      <fontinfo>
        <ae>Arial</ae>
        <ae>10</ae>
        <ae>plain</ae>
      </fontinfo>
      <justify>left</justify>
      <itemlocation>
        <ae>
          <ae>absolute</ae>
          <ae>16</ae>
          <ae>909</ae>
        </ae>
        <ae>
          <ae>extent</ae>
          <ae>942</ae>
          <ae>27</ae>
        </ae>
      </itemlocation>
    </label>
    <label sid="G_">
      <value>each violation by a fine of not less than five thousand dollars ($5,000) and not more than ten thousand dollars ($10,000), or a</value>
      <fontinfo>
        <ae>Arial</ae>
        <ae>10</ae>
        <ae>plain</ae>
      </fontinfo>
      <justify>left</justify>
      <itemlocation>
        <ae>
          <ae>absolute</ae>
          <ae>16</ae>
          <ae>928</ae>
        </ae>
        <ae>
          <ae>extent</ae>
          <ae>923</ae>
          <ae>27</ae>
        </ae>
      </itemlocation>
    </label>
    <label sid="H_">
      <value>fixed term of imprisonment for three (3) years, or both penalties.  Should aggravating circumstances [be] present, the penalty</value>
      <fontinfo>
        <ae>Arial</ae>
        <ae>10</ae>
        <ae>plain</ae>
      </fontinfo>
      <justify>left</justify>
      <itemlocation>
        <ae>
          <ae>absolute</ae>
          <ae>16</ae>
          <ae>947</ae>
        </ae>
        <ae>
          <ae>extent</ae>
          <ae>925</ae>
          <ae>27</ae>
        </ae>
      </itemlocation>
    </label>
    <label sid="I_">
      <value>thus established may be increased to a maximum of five (5) years, if extenuating circumstances are present, it may be reduced</value>
      <fontinfo>
        <ae>Arial</ae>
        <ae>10</ae>
        <ae>plain</ae>
      </fontinfo>
      <justify>left</justify>
      <itemlocation>
        <ae>
          <ae>absolute</ae>
          <ae>16</ae>
          <ae>966</ae>
        </ae>
        <ae>
          <ae>extent</ae>
          <ae>943</ae>
          <ae>27</ae>
        </ae>
      </itemlocation>
    </label>
    <label sid="J_">
      <value>to a minimum of two (2) years.</value>
      <fontinfo>
        <ae>Arial</ae>
        <ae>10</ae>
        <ae>plain</ae>
      </fontinfo>
      <justify>left</justify>
      <itemlocation>
        <ae>
          <ae>absolute</ae>
          <ae>16</ae>
          <ae>985</ae>
        </ae>
        <ae>
          <ae>extent</ae>
          <ae>240</ae>
          <ae>27</ae>
        </ae>
      </itemlocation>
    </label>
    <line sid="K_">
      <itemlocation>
        <ae>
          <ae>absolute</ae>
          <ae>18</ae>
          <ae>821</ae>
        </ae>
        <ae>
          <ae>extent</ae>
          <ae>0</ae>
          <ae>0</ae>
        </ae>
      </itemlocation>
    </line>
    <label sid="L_">
      <value>Applicable in OR</value>
      <fontinfo>
        <ae>Arial</ae>
        <ae>10</ae>
        <ae>bold</ae>
      </fontinfo>
      <justify>left</justify>
      <itemlocation>
