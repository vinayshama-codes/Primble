    </line>
    <label sid="T_">
      <value>Applicable in ME, TN, VA and WA</value>
      <fontinfo>
        <ae>Arial</ae>
        <ae>10</ae>
        <ae>bold</ae>
      </fontinfo>
      <justify>left</justify>
      <itemlocation>
