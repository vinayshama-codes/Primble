          <ae>alignt2t</ae>
          <ae>P_</ae>
        </ae>
        <ae>
          <ae>offset</ae>
          <ae>-10</ae>
          <ae>0</ae>
        </ae>
      </itemlocation>
    </label>
    <label sid="R_">
      <value>subject to criminal and civil penalties.</value>
      <fontinfo>
        <ae>Arial</ae>
        <ae>10</ae>
        <ae>plain</ae>
      </fontinfo>
      <justify>left</justify>
      <itemlocation>
