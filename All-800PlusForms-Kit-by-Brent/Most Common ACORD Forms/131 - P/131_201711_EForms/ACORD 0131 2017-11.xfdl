    </field>
    <help sid="HelpProducer_CustomerIdentifier_A">
      <value>Enter identifier: The customer's identification number assigned by the producer (e.g., agency or brokerage). </value>
    </help>
    <spacer sid="content_spacer">
      <itemlocation>
        <ae>
          <ae>absolute</ae>
          <ae>0</ae>
